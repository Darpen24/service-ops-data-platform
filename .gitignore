# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data outputs (directory structure is retained with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# dbt and Power BI generated outputs
dbt/target/
dbt/logs/
dbt/**/target/
dbt/**/logs/
dbt/service_ops/profiles.yml
dbt/**/.user.yml
logs/

# Terraform state, plans, and machine-local overrides
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.tfvars
*.auto.tfvars
!*.tfvars.example
powerbi/**/bin/
powerbi/**/obj/
